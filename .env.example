# Gemini API Anahtarı (Zorunlu)
GEMINI_API_KEY=your_gemini_api_key_here

# PII Guard Yapılandırması (İsteğe bağlı - varsayılan değerler gösterilmektedir)
# PII_GUARD_GEMINI_MODEL=gemini-2.5-flash
# PII_GUARD_TOKEN_MIN_LEN=4
# PII_GUARD_DLP_NER_ENABLED=true
# PII_GUARD_NER_SCORE_THRESHOLD=0.6
# PII_GUARD_LOG_LEVEL=INFO
# PII_GUARD_LOG_DIR=logs
